{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "process",
			"command": "py",
			"args": ["-3", "${workspaceFolder}/build-release.py"],
			"group": "build",
			"label": "Build releases using py launcher"
		},
		{
			"type": "shell",
			"command": "python",
			"args": ["${workspaceFolder}/build-release.py"],
			"group": "build",
			"label": "Build releases using env python"
		}
	]
}